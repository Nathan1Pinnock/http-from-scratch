<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HttpFromScratch\HttpFromScratch.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sample site lives next to the app so "dotnet run" can serve it from the www folder. -->
    <None Include="www\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
